# Keep the build context limited to inputs explicitly consumed by the Dockerfile.
**
!Dockerfile
!.dockerignore
!package.json
!package-lock.json
!tsconfig.json
!tsconfig.app.json
!tsconfig.node.json
!vite.config.ts
!index.html
!nginx.conf
!public/
!public/**
!src/
!src/**

# Defense in depth: never send secrets, host dependencies, or generated state.
.env*
**/.env*
node_modules/
**/node_modules/
dist/
**/dist/
coverage/
**/coverage/
*.tsbuildinfo
**/*.tsbuildinfo
*.log
**/*.log
