# Source this file from the repository root when running services on the host.
# Copy it to .env.local and replace every `replace_with_...` value first.

NODE_ENV=development
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=debug

DATABASE_URL=postgresql://cue:cue_dev_password@127.0.0.1:5432/cue
BETTER_AUTH_SECRET=replace_with_a_random_secret_of_at_least_32_characters
BETTER_AUTH_URL=http://localhost:8000
CLIENT_ORIGIN=http://localhost:5173
WORKER_TOKEN=replace_with_a_random_worker_token_of_at_least_32_characters
TMDB_API_TOKEN=replace_with_your_tmdb_read_access_token
TMDB_API_KEY=replace_with_your_tmdb_api_key

API_URL=http://127.0.0.1:8000
VITE_API_URL=http://localhost:8000/api
DAGSTER_HOME=${PWD}/worker
DAGSTER_STORAGE_DIR=${PWD}/worker/.dagster/storage
DAGSTER_COMPUTE_LOGS_DIR=${PWD}/worker/.dagster/compute_logs
