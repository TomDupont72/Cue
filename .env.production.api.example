# Install as /etc/cue-api.env after replacing every placeholder.
NODE_ENV=production
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Use the PostgreSQL DNS name reachable on the Docker infrastructure network.
DATABASE_URL=postgresql://cue:replace_with_database_password@postgres.internal:5432/cue
BETTER_AUTH_SECRET=replace_with_a_random_secret_of_at_least_32_characters
BETTER_AUTH_URL=https://cue.example.com
CLIENT_ORIGIN=https://cue.example.com
WORKER_TOKEN=replace_with_a_random_worker_token_of_at_least_32_characters
TMDB_API_TOKEN=replace_with_your_tmdb_read_access_token
TMDB_API_KEY=replace_with_your_tmdb_api_key
