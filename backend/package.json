{
  "name": "backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc && tsc-alias",
    "test": "tsc --noEmit -p tsconfig.test.json && node --import tsx --test src/modules/*/__tests__/*.test.ts src/shared/config/__tests__/*.test.ts src/shared/errors/__tests__/*.test.ts src/shared/utils/*/__tests__/*.test.ts",
    "test:integration": "tsc --noEmit -p tsconfig.test.json && node --import tsx --test src/integration/*.integration.test.ts",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@fastify/auth": "^5.0.4",
    "@fastify/bearer-auth": "^10.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/swagger": "^9.8.0",
    "@fastify/swagger-ui": "^6.1.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "better-auth": "^1.6.23",
    "dotenv": "^17.4.2",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fastify": "^5.10.0",
    "fastify-type-provider-zod": "^7.0.0",
    "globals": "^17.7.0",
    "p-limit": "^7.3.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.5",
    "prisma": "^7.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.0",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.63.0"
  }
}
