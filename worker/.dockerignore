# Keep the build context limited to inputs explicitly consumed by the Dockerfile.
**
!Dockerfile
!.dockerignore
!pyproject.toml
!uv.lock
!dagster.yaml
!src/
!src/**

# Defense in depth: never send secrets or local Python environments.
.env*
**/.env*
.venv/
**/.venv/
venv/
**/venv/
__pycache__/
**/__pycache__/
*.py[cod]
**/*.py[cod]
build/
**/build/
dist/
**/dist/
*.egg-info/
**/*.egg-info/
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
**/.mypy_cache/
.ruff_cache/
**/.ruff_cache/
.coverage*
**/.coverage*
*.log
**/*.log

# Dagster telemetry and runtime state must live in the named volume, not the image.
.dg/
**/.dg/
.telemetry/
**/.telemetry/
.dagster/
**/.dagster/
.dagster_home/
**/.dagster_home/
dagster_home/
**/dagster_home/
.tmp_dagster_home_*/
**/.tmp_dagster_home_*/
storage/
**/storage/
compute_logs/
**/compute_logs/
history/
**/history/
schedules/
**/schedules/
*.db
**/*.db
*.db-*
**/*.db-*
*.sqlite*
**/*.sqlite*
