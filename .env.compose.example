# Copy this file to .env.compose before starting the Docker Compose stack.
# Values below are development-only. Replace every `replace_with_...` value.

COMPOSE_PROJECT_NAME=cue

POSTGRES_DB=cue
POSTGRES_USER=cue
POSTGRES_PASSWORD=cue_dev_password
POSTGRES_PORT=5432

LOG_LEVEL=debug
BETTER_AUTH_SECRET=replace_with_a_random_secret_of_at_least_32_characters
WORKER_TOKEN=replace_with_a_random_worker_token_of_at_least_32_characters
TMDB_API_TOKEN=replace_with_your_tmdb_read_access_token
TMDB_API_KEY=replace_with_your_tmdb_api_key
